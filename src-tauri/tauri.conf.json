{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Inkwell",
  "version": "0.1.0",
  "identifier": "app.inkwell.desktop",
  "mainBinaryName": "inkwell",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist",
    "windows": { "staticVCRuntime": false }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Inkwell",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480,
        "decorations": false,
        "backgroundColor": "#17181b",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-low-end-device-mode"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://inkwell.localhost; media-src http://inkwell.localhost/m/ inkwell://localhost/m/; object-src 'none'; base-uri 'none'; frame-ancestors 'none'",
      "devCsp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ws://localhost:1420 ipc: http://ipc.localhost http://inkwell.localhost; media-src http://inkwell.localhost/m/ inkwell://localhost/m/; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "publisher": "Berkay",
    "copyright": "Copyright (C) 2026 Berkay",
    "licenseFile": "../LICENSE",
    "category": "Productivity",
    "shortDescription": "A fast, private PDF app.",
    "longDescription": "Inkwell is a local, private PDF app for Windows: read, annotate, fill, edit, sign, convert and organise PDFs without an account or a network service.",
    "windows": {
      "allowDowngrades": false,
      "webviewInstallMode": { "type": "embedBootstrapper", "silent": true },
      "wix": {
        "upgradeCode": "A7BB0957-BACE-46F2-A766-0F5C17191026",
        "language": "en-US",
        "template": "wix/main.wxs"
      }
    },
    "resources": {
      "icons/pdf-document.ico": "pdf-document.ico",
      "../LICENSE": "licenses/LICENSE-AGPL-3.0.txt",
      "../third_party/THIRD-PARTY-NOTICES.txt": "licenses/THIRD-PARTY-NOTICES.txt",
      "../third_party/RUST-AND-NPM-DEPENDENCIES.txt": "licenses/RUST-AND-NPM-DEPENDENCIES.txt",
      "../vendor/mupdf-sys/mupdf/thirdparty/freetype/LICENSE.TXT": "licenses/mupdf/freetype/LICENSE.TXT",
      "../vendor/mupdf-sys/mupdf/thirdparty/harfbuzz/COPYING": "licenses/mupdf/harfbuzz/COPYING",
      "../vendor/mupdf-sys/mupdf/thirdparty/lcms2/LICENSE": "licenses/mupdf/lcms2/LICENSE",
      "../vendor/mupdf-sys/mupdf/thirdparty/openjpeg/LICENSE": "licenses/mupdf/openjpeg/LICENSE",
      "../vendor/mupdf-sys/mupdf/thirdparty/zlib/LICENSE": "licenses/mupdf/zlib/LICENSE",
      "../vendor/mupdf-sys/mupdf/thirdparty/brotli/LICENSE": "licenses/mupdf/brotli/LICENSE",
      "../vendor/mupdf-sys/mupdf/thirdparty/mujs/COPYING": "licenses/mupdf/mujs/COPYING",
      "../vendor/mupdf-sys/mupdf/thirdparty/tesseract/LICENSE": "licenses/mupdf/tesseract/LICENSE",
      "../third_party/fonts/OFL-NotoSans.txt": "licenses/OFL-NotoSans.txt",
      "../third_party/fonts/OFL-NotoSansCJK.txt": "licenses/OFL-NotoSansCJK.txt",
      "../third_party/fluent/LICENSE-MIT": "licenses/fluent/LICENSE-MIT",
      "../third_party/pdfcraft/LICENSE-MIT": "licenses/pdfcraft/LICENSE-MIT",
      "../third_party/pdfcraft/LICENSE-APACHE": "licenses/pdfcraft/LICENSE-APACHE",
      "../third_party/pdfcraft/NOTICE": "licenses/pdfcraft/NOTICE"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
